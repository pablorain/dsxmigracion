                    "value": "@dataset().ADLS_Container",
                    "type": "Expression"
                },
                "folderPath": {
                    "value": "@dataset().PathExtract",
                    "type": "Expression"
                },
                "fileName": {
                    "value": "@concat(dataset().NombreArchExtraccion, '.', dataset().FechaArchExtraccion)",
                    "type": "Expression"
                }
            },
            "columnDelimiter": "|",
