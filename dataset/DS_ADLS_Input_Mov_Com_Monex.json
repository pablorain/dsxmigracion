{
    "name": "DS_ADLS_Input_Mov_Com_Monex",
    "type": "Microsoft.DataFactory/factories/datasets",
    "properties": {
        "description": "Dataset de entrada Job 1 J390_Movimiento_Compra_Monex. Origen DS: Seq_Mov_Com_Monex (CSeqFileStage). Archivo: #$PathExtract##$NombreArchExtraccion#.#$FechaArchExtraccion#. Default NombreArchExtraccion=J390_Movimiento_Compra_Monex.TXT. Delimitador: |",
        "linkedServiceName": {
