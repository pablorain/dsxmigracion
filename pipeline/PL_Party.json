            "AzureFunction_Key": { "type": "String", "defaultValue": "" },
            "API_Threshold": { "type": "String", "defaultValue": "0", "description": "MANUAL_INTERVENTION: Umbral bytes fncEvaluaCargaTeradata." },
            "MLOAD_Threshold": { "type": "String", "defaultValue": "0", "description": "MANUAL_INTERVENTION: Umbral bytes fncEvaluaCargaTeradata." }
