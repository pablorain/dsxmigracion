{
    "name": "PL_Party",
    "type": "Microsoft.DataFactory/factories/pipelines",
    "properties": {
        "description": "Routing pipeline para Party. DS: fncEvaluaCargaTeradata -> API/MLOAD/TPUMP. ADF: GetMetadata -> SetVariable -> IfCondition. MANUAL_INTERVENTION: umbrales.",
        "activities": [
            { "name": "Get_FileSize_Party", "type": "GetMetadata", "dependsOn": [], "policy": { "timeout": "0.01:00:00", "retry": 0, "retryIntervalInSeconds": 30 }, "typeProperties": { "dataset": { "referenceName": "DS_ADLS_S139_FLoad_Input", "type": "DatasetReference", "parameters": { "PathOutput": { "value": "@pipeline().parameters.PathOutput", "type": "Expression" }, "FileName": { "value": "@pipeline().parameters.FileName", "type": "Expression" }, "ADLS_Container": { "value": "@pipeline().parameters.ADLS_Container", "type": "Expression" } } }, "fieldList": ["size"] } },
            { "name": "Set_LoadRoute_Party", "type": "SetVariable", "dependsOn": [{ "activity": "Get_FileSize_Party", "dependencyConditions": ["Succeeded"] }], "typeProperties": { "variableName": "LoadRoute", "value": { "value": "@if(lessOrEquals(int(string(activity('Get_FileSize_Party').output.size)), int(pipeline().parameters.API_Threshold)), 'API', if(lessOrEquals(int(string(activity('Get_FileSize_Party').output.size)), int(pipeline().parameters.MLOAD_Threshold)), 'MLOAD', 'TPUMP'))", "type": "Expression" } } },
            { "name": "If_Api_Party", "type": "IfCondition", "dependsOn": [{ "activity": "Set_LoadRoute_Party", "dependencyConditions": ["Succeeded"] }], "typeProperties": { "expression": { "value": "@equals(variables('LoadRoute'), 'API')", "type": "Expression" }, "ifTrueActivities": [{ "name": "Exec_Party_Api", "type": "ExecutePipeline", "dependsOn": [], "typeProperties": { "pipeline": { "referenceName": "PL_Party_Api", "type": "PipelineReference" }, "waitOnCompletion": true, "parameters": { "PathOutput": { "value": "@pipeline().parameters.PathOutput", "type": "Expression" }, "FileName": { "value": "@pipeline().parameters.FileName", "type": "Expression" }, "Tabla": { "value": "@pipeline().parameters.Tabla", "type": "Expression" }, "Teradata_EDW_DSN": { "value": "@pipeline().parameters.Teradata_EDW_DSN", "type": "Expression" }, "EDW_Wrk": { "value": "@pipeline().parameters.EDW_Wrk", "type": "Expression" }, "EDW_Agreement": { "value": "@pipeline().parameters.EDW_Agreement", "type": "Expression" }, "ADLS_Container": { "value": "@pipeline().parameters.ADLS_Container", "type": "Expression" }, "AzureFunction_FastLoad_Url": { "value": "@pipeline().parameters.AzureFunction_FastLoad_Url", "type": "Expression" }, "AzureFunction_Key": { "value": "@pipeline().parameters.AzureFunction_Key", "type": "Expression" } } } }], "ifFalseActivities": [{ "name": "If_Mload_Party", "type": "IfCondition", "dependsOn": [], "typeProperties": { "expression": { "value": "@equals(variables('LoadRoute'), 'MLOAD')", "type": "Expression" }, "ifTrueActivities": [{ "name": "Exec_Party_Mload", "type": "ExecutePipeline", "dependsOn": [], "typeProperties": { "pipeline": { "referenceName": "PL_Party_Mload", "type": "PipelineReference" }, "waitOnCompletion": true, "parameters": { "PathOutput": { "value": "@pipeline().parameters.PathOutput", "type": "Expression" }, "FileName": { "value": "@pipeline().parameters.FileName", "type": "Expression" }, "Teradata_EDW_DSN": { "value": "@pipeline().parameters.Teradata_EDW_DSN", "type": "Expression" }, "EDW_Wrk": { "value": "@pipeline().parameters.EDW_Wrk", "type": "Expression" }, "EDW_Agreement": { "value": "@pipeline().parameters.EDW_Agreement", "type": "Expression" }, "PathShell": { "value": "@pipeline().parameters.PathShell", "type": "Expression" }, "PathLog": { "value": "@pipeline().parameters.PathLog", "type": "Expression" }, "ADLS_Container": { "value": "@pipeline().parameters.ADLS_Container", "type": "Expression" }, "AzureFunction_Bteq_Url": { "value": "@pipeline().parameters.AzureFunction_FastLoad_Url", "type": "Expression" }, "AzureFunction_Key": { "value": "@pipeline().parameters.AzureFunction_Key", "type": "Expression" } } } }], "ifFalseActivities": [{ "name": "Exec_Party_Tpump", "type": "ExecutePipeline", "dependsOn": [], "typeProperties": { "pipeline": { "referenceName": "PL_Party_Tpump", "type": "PipelineReference" }, "waitOnCompletion": true, "parameters": { "PathOutput": { "value": "@pipeline().parameters.PathOutput", "type": "Expression" }, "FileName": { "value": "@pipeline().parameters.FileName", "type": "Expression" }, "Teradata_EDW_DSN": { "value": "@pipeline().parameters.Teradata_EDW_DSN", "type": "Expression" }, "EDW_Wrk": { "value": "@pipeline().parameters.EDW_Wrk", "type": "Expression" }, "EDW_Agreement": { "value": "@pipeline().parameters.EDW_Agreement", "type": "Expression" }, "PathShell": { "value": "@pipeline().parameters.PathShell", "type": "Expression" }, "PathLog": { "value": "@pipeline().parameters.PathLog", "type": "Expression" }, "ADLS_Container": { "value": "@pipeline().parameters.ADLS_Container", "type": "Expression" }, "AzureFunction_Bteq_Url": { "value": "@pipeline().parameters.AzureFunction_FastLoad_Url", "type": "Expression" }, "AzureFunction_Key": { "value": "@pipeline().parameters.AzureFunction_Key", "type": "Expression" } } } }] } }] } }
        ],
        "parameters": {
            "PathOutput": { "type": "String", "defaultValue": "" }, "FileName": { "type": "String", "defaultValue": "" },
            "Tabla": { "type": "String", "defaultValue": "J139_MCF" }, "Teradata_EDW_DSN": { "type": "String", "defaultValue": "" },
            "EDW_Wrk": { "type": "String", "defaultValue": "" }, "EDW_Agreement": { "type": "String", "defaultValue": "" },
