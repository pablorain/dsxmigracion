{
  "$schema": "http://schema.management.azure.com/schemas/2015-01-01/Microsoft.DataFactory.json#",
  "contentVersion": "1.0.0.0",
  "name": "pl_FLoad_Bci_Card_Balance",
  "properties": {
    "description": "BCI Card Balance FLoad. Source: J139_TRANSBK_MCF_TARJETAS_BCI_CARD_BALANCE.TXT. Target: Bci_Card_Balance_#Tabla#.",
    "activities": [
      {
        "name": "FLoad_Bci_Card_Balance",
        "description": "Bulk load ADLS output file into Teradata temp table. Replicates DataStage TeradataConnector FastLoad (WriteMode=0). Source: ds_MCF_Tarjetas_BciCardBalance. Temp table: Bci_Card_Balance_#Tabla# in $EDW_Wrk.",
        "type": "Copy",
        "dependsOn": [],
        "policy": {
          "timeout": "2.00:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60
        },
        "typeProperties": {
          "source": {
            "type": "DelimitedTextSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings",
              "recursive": false
            },
            "formatSettings": {
              "type": "DelimitedTextReadSettings"
            }
          },
          "sink": {
            "type": "TeradataSink",
            "writeMethod": "AutoCreate",
            "preCopyScript": "DELETE FROM @{pipeline().parameters.EDW_Wrk}.Bci_Card_Balance_@{pipeline().parameters.Tabla}"
          },
          "enableStaging": true,
          "stagingSettings": {
            "linkedService": {
              "referenceName": "ls_AzureDataLakeStorage_S139",
              "type": "LinkedServiceReference"
            },
            "path": "mcf-staging/fload"
          }
        },
        "inputs": [
          {
            "referenceName": "ds_MCF_Tarjetas_BciCardBalance",
            "type": "DatasetReference",
            "parameters": {
              "PathOutput": {
                "value": "@pipeline().parameters.PathOutput",
                "type": "Expression"
              },
              "FechaProceso": {
                "value": "@pipeline().parameters.FechaProceso",
                "type": "Expression"
              }
            }
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_Td_Bci_Card_Balance_Tmp",
            "type": "DatasetReference",
            "parameters": {
              "Tabla": {
                "value": "@pipeline().parameters.Tabla",
                "type": "Expression"
              },
              "Database": {
                "value": "@pipeline().parameters.EDW_Wrk",
                "type": "Expression"
              }
            }
          }
        ]
      },
      {
        "name": "Bteq_Bci_Card_Balance",
        "description": "Execute BTEQ INSERT/SELECT from temp table to final EDW table. Maps to DataStage AfterSubr DSU.ExecSH Bteq_Bci_Card_Balance.sh. ADF: Databricks notebook with Teradata JDBC.",
        "type": "DatabricksNotebook",
        "dependsOn": [
          {
            "activity": "FLoad_Bci_Card_Balance",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "linkedServiceName": {
          "referenceName": "ls_AzureDatabricks_S139",
          "type": "LinkedServiceReference"
        },
        "typeProperties": {
          "notebookPath": "/notebooks/S139_Transbk_Mcf/Bteq/Bteq_Bci_Card_Balance",
          "baseParameters": {
            "Teradata_EDW_DSN": {
              "value": "@pipeline().parameters.Teradata_EDW_DSN",
              "type": "Expression"
            },
            "Teradata_EDW_User": {
              "value": "@pipeline().parameters.Teradata_EDW_User",
              "type": "Expression"
            },
            "Teradata_EDW_PWD": {
              "value": "@pipeline().parameters.Teradata_EDW_PWD",
              "type": "Expression"
            },
            "EDW_Wrk": {
              "value": "@pipeline().parameters.EDW_Wrk",
              "type": "Expression"
            },
            "EDW_Agreement": {
              "value": "@pipeline().parameters.EDW_Agreement",
              "type": "Expression"
            },
            "FechaProceso": {
              "value": "@pipeline().parameters.FechaProceso",
              "type": "Expression"
            },
            "Tabla": {
              "value": "@pipeline().parameters.Tabla",
              "type": "Expression"
            }
          }
        }
      }
    ],
    "parameters": {
      "FechaProceso": {
        "type": "String"
      },
      "Teradata_EDW_DSN": {
        "type": "String"
      },
      "Teradata_EDW_User": {
        "type": "String"
      },
      "Teradata_EDW_PWD": {
        "type": "String"
      },
      "EDW_Wrk": {
        "type": "String"
      },
      "EDW_Agreement": {
        "type": "String"
      },
      "PathOutput": {
        "type": "String"
      },
      "Tabla": {
        "type": "String",
        "defaultValue": "A"
      }
    },
    "annotations": [
      "datastage_pattern: TeradataConnector FastLoad -> AfterSubr DSU.ExecSH BTEQ",
      "datastage_bteq_script: Bteq_Bci_Card_Balance.sh",
      "datastage_temp_table: Bci_Card_Balance_#Tabla#",
      "manual_action: Create Databricks notebook at /notebooks/S139_Transbk_Mcf/Bteq/Bteq_Bci_Card_Balance",
      "manual_action: Notebook must connect to Teradata via JDBC and run BTEQ-equivalent INSERT/UPDATE logic from original .sh script"
    ],
    "folder": {
      "name": "S139_Transbk_Mcf/FLoad_LDM"
    }
  }
}