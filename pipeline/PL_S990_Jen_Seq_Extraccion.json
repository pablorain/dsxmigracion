{
    "name": "PL_S990_Jen_Seq_Extraccion",
    "properties": {
        "description": "Migrado de S990_Jen_Seq_Extraccion (DataStage Sequencer, JobType=2). Flujo: IfCondition(FlagExtraccion=1) -> ExecutePipeline IB -> ExecutePipeline No_IB. Identico al visual del sequencer DataStage: V22S0(CJSCondition) -> V20S0(J990_Jen_Extraccion_IB) -> V21S0(J990_Jen_Extraccion_No_IB). Credenciales Sybase y Teradata siempre via AKV (nunca como parametros de pipeline).",
        "activities": [
            {
                "name": "Valida_Extraccion",
                "description": "DataStage: CJSCondition V22S0 'Valida_Ejecucion'. Si FlagExtraccion=1 ejecuta ambas extracciones; si =0 no ejecuta nada.",
                "type": "IfCondition",
                "dependsOn": [],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@equals(pipeline().parameters.FlagExtraccion, '1')",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "J990_Jen_Extraccion_IB",
                            "description": "DataStage: CJSJobActivity V20S0. Extrae registros IB (jen_fec_evt_neg = FechaProceso-7 dias). Ejecuta primero.",
                            "type": "ExecutePipeline",
                            "dependsOn": [],
                            "policy": {
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "pipeline": {
                                    "referenceName": "PL_J990_Jen_Extraccion_IB",
                                    "type": "PipelineReference"
                                },
                                "waitOnCompletion": true,
                                "parameters": {
                                    "FechaProceso": {
                                        "value": "@pipeline().parameters.FechaProceso",
                                        "type": "Expression"
                                    },
                                    "FechaArchExtraccion": {
                                        "value": "@pipeline().parameters.FechaArchExtraccion",
                                        "type": "Expression"
                                    },
                                    "DBO_Journal": {
                                        "value": "@pipeline().parameters.DBO_Journal",
                                        "type": "Expression"
                                    },
                                    "PathTemp": {
                                        "value": "@pipeline().parameters.PathTemp",
                                        "type": "Expression"
                                    },
                                    "NombreJob": {
                                        "value": "@pipeline().parameters.NombreJob",
                                        "type": "Expression"
                                    },
                                    "ADLS_Container": {
                                        "value": "@pipeline().parameters.ADLS_Container",
                                        "type": "Expression"
                                    }
                                }
                            }
                        },
                        {
                            "name": "J990_Jen_Extraccion_No_IB",
                            "description": "DataStage: CJSJobActivity V21S0. Extrae registros No-IB (jen_fec_evt_neg = FechaProceso exacto). Ejecuta despues de IB (dependencia secuencial del sequencer).",
                            "type": "ExecutePipeline",
                            "dependsOn": [
                                {
                                    "activity": "J990_Jen_Extraccion_IB",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "pipeline": {
                                    "referenceName": "PL_J990_Jen_Extraccion_No_IB",
                                    "type": "PipelineReference"
                                },
                                "waitOnCompletion": true,
                                "parameters": {
                                    "FechaProceso": {
                                        "value": "@pipeline().parameters.FechaProceso",
                                        "type": "Expression"
                                    },
                                    "FechaArchExtraccion": {
                                        "value": "@pipeline().parameters.FechaArchExtraccion",
                                        "type": "Expression"
                                    },
                                    "DBO_Journal": {
                                        "value": "@pipeline().parameters.DBO_Journal",
                                        "type": "Expression"
                                    },
                                    "PathTemp": {
                                        "value": "@pipeline().parameters.PathTemp",
                                        "type": "Expression"
                                    },
                                    "NombreJob": {
                                        "value": "@pipeline().parameters.NombreJob",
                                        "type": "Expression"
                                    },
                                    "ADLS_Container": {
                                        "value": "@pipeline().parameters.ADLS_Container",
                                        "type": "Expression"
                                    }
                                }
                            }
                        }
                    ],
                    "ifFalseActivities": []
                }
            }
        ],
        "parameters": {
            "FechaProceso": {
                "type": "String",
                "defaultValue": ""
            },
            "FechaArchExtraccion": {
                "type": "String",
                "defaultValue": ""
            },
            "FlagExtraccion": {
                "type": "String",
                "defaultValue": "1"
            },
            "NombreJob": {
                "type": "String",
                "defaultValue": "J990_Jen"
            },
            "AcronimoTabla": {
                "type": "String",
                "defaultValue": "J990JEN"
            },
            "DBO_Journal": {
                "type": "String",
                "defaultValue": "journal.dbo"
            },
            "Sybase_Journal": {
                "type": "String",
                "defaultValue": ""
            },
            "Sybase_User": {
                "type": "String",
                "defaultValue": ""
            },
            "Teradata_EDW_DSN": {
                "type": "String",
                "defaultValue": ""
            },
            "Teradata_EDW_User_Grupo1": {
                "type": "String",
                "defaultValue": ""
            },
            "EDW_Param_and_Others": {
