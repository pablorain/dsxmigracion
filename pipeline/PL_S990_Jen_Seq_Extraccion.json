            },
            "PathLog_Hist": {
                "type": "String",
                "defaultValue": ""
            },
            "PathOutput_Hist": {
                "type": "String",
                "defaultValue": ""
            },
            "MsgFileDiff": {
                "type": "String",
                "defaultValue": ""
            },
            "FlagDelete": {
                "type": "String",
                "defaultValue": "0"
            },
            "TD_ML_CheckPoint": {
                "type": "String",
                "defaultValue": ""
            },
            "ADLS_Container": {
                "type": "String",
                "defaultValue": ""
            }
        },
        "annotations": [
            "DataStage: S990_Jen_Seq_Extraccion (JobType=2 Sequencer)",
            "Categoria: Jobs/Fase_5/Hito_0/Param_and_Others/J990_Jen",
            "SEGURIDAD: Sybase_PWD y Teradata_EDW_PWD_Grupo1 NO son parametros - se inyectan via AKV en los LinkedServices",
            "Checkpoint DataStage DSCheckPointExists/SetValue -> ADF SetVariable @utcNow() (implementar si se requiere restart)"
        ],
        "folder": {
            "name": "J990_Jen/Sequencers"
        }
    }
}
